{% doc %}
  @prompt
    create a horizontal block stating that salaam pizza are available on grabfood, foodpanda and for pickup
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-delivery-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-delivery-banner__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.spacing }}px;
    flex-wrap: wrap;
  }

  .ai-delivery-banner__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    margin: 0;
  }

  .ai-delivery-banner__platforms-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.platform_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-delivery-banner__platform-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    padding: {{ block.settings.platform_padding }}px {{ block.settings.platform_padding | times: 1.5 }}px;
    background-color: {{ block.settings.platform_bg_color }};
    color: {{ block.settings.platform_text_color }};
    border-radius: {{ block.settings.platform_border_radius }}px;
    font-size: {{ block.settings.platform_text_size }}px;
    font-weight: {{ block.settings.platform_text_weight }};
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-delivery-banner__platform-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.platform_hover_bg_color }};
    color: {{ block.settings.platform_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-delivery-banner__container-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-delivery-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-delivery-banner__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <p class="ai-delivery-banner__text-{{ ai_gen_id }}">{{ block.settings.heading }}</p>
    {% endif %}
    
    <div class="ai-delivery-banner__platforms-{{ ai_gen_id }}">
      {% if block.settings.show_grabfood %}
        <a 
          href="{{ block.settings.grabfood_url }}" 
          class="ai-delivery-banner__platform-{{ ai_gen_id }}"
          {% if block.settings.grabfood_url == blank %}aria-disabled="true"{% endif %}
        >
          {{ block.settings.grabfood_text }}
        </a>
      {% endif %}
      
      {% if block.settings.show_foodpanda %}
        <a 
          href="{{ block.settings.foodpanda_url }}" 
          class="ai-delivery-banner__platform-{{ ai_gen_id }}"
          {% if block.settings.foodpanda_url == blank %}aria-disabled="true"{% endif %}
        >
          {{ block.settings.foodpanda_text }}
        </a>
      {% endif %}
      
      {% if block.settings.show_pickup %}
        <a 
          href="{{ block.settings.pickup_url }}" 
          class="ai-delivery-banner__platform-{{ ai_gen_id }}"
          {% if block.settings.pickup_url == blank %}aria-disabled="true"{% endif %}
        >
          {{ block.settings.pickup_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

