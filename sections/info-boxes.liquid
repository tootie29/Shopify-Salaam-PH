{%- assign main_background = section.settings.main_background -%}


<section id="{{ section.id }}" class="section info-boxes-section">
    <div class="section--container">
        {% if section.settings.title != blank %}
            <div class="section--header">
                <h2>{{ section.settings.title }}</h2>
            </div>
        {% endif %}
        <div class="section--body">
            <div class="section--body-content info-boxes">
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'info_boxes' %}
                            <div class="info-box">
                                <div class="info-box-inner">
                                    {% if block.settings.info_box_icon != blank %}
                                        <div class="info-box-icon">{{ block.settings.info_box_icon }}</div>
                                    {% endif %}
                                    {% if block.settings.info_box_title != blank %}
                                        <h3>{{ block.settings.info_box_title }}</h3>
                                    {% endif %}
                                    {% if block.settings.info_box_content != blank %}
                                        <div class="info-box-content">{{ block.settings.info_box_content }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endcase %}
                {% endfor %}
            </div>
            <div class="section--body-content">
                <div class="section--body-content-inner" style="background-image: url('{{ section.settings.main_background | image_url: width: 1000 }}');">
                    <div class="section--body-content-inner-content">
                        <div class="section--body-content-inner-content-inner">
                            {% if section.settings.main_icon != blank %}
                                <div class="section--body-content-inner-content-icon">{{ section.settings.main_icon }}</div>
                            {% endif %}
                            {% if section.settings.main_title != blank or section.settings.main_content != blank %}
                                <div class="section--body-content-inner-content-header">
                                    {% if section.settings.main_title != blank %}
                                        <h3>{{ section.settings.main_title }}</h3>
                                    {% endif %}
                                    {% if section.settings.main_content != blank %}
                                        <div class="section--body-content-inner-content-content">{{ section.settings.main_content }}</div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


{% schema %}
  {
  "name": "Info Boxes",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title"
    },
    {
      "type": "richtext",
      "id": "main_content",
      "label": "Main Content"
    },
    {
      "type": "html",
      "id": "main_icon",
      "label": "Main Icon"
    },
    {
      "type": "image_picker",
      "id": "main_background",
      "label": "Main Background"
    }
  ],
  "blocks": [
    {
      "name": "Info Boxes",
      "type": "info_boxes",
      "settings": [
        {
          "type": "text",
          "id": "info_box_title",
          "label": "Info Box Title"
        },
        {
          "type": "richtext",
          "id": "info_box_content",
          "label": "Info Box Content"
        },
        {
          "type": "html",
          "id": "info_box_icon",
          "label": "Info Box Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Info Boxes"
    }
  ]
}  
{% endschema %}

{% style %}
#{{ section.id }} {
    background-color: #F3F0F0;
}
#{{ section.id }} .section--container {
    display: flex;
    flex-flow: column nowrap;
    gap: 60px;
}
#{{ section.id }} .section--container .section--header {
    display: flex;
    flex-flow: column nowrap;
    justify-content: center;
    align-items: center;
    gap: 16px;
}
#{{ section.id }} .section--container .section--header h2 {
  margin: 0;
  text-align: center;
}
#{{ section.id }} .section--container .section--body {
    display: flex;
    flex-flow: row wrap;
    gap: 40px;
    width: 100%;
}
#{{ section.id }} .section--container .section--body .section--body-content {
    width: 100%;
    max-width: calc(50% - (40px * 1 / 2));
}
#{{ section.id }} .section--container .section--body .info-boxes {
    display: flex;
    flex-flow: row wrap;
    gap: 24px;
}
#{{ section.id }} .section--container .section--body .info-boxes .info-box {
    width: 100%;
    max-width: calc(50% - (24px * 1 / 2));
    border-radius: 40px;
    background: #FFF;
    box-shadow: 0 25px 55.4px 0 rgba(0, 0, 0, 0.05);
    display: flex;
    flex-flow: column nowrap;
    gap: 24px;
    padding: 40px 32px;
}
#{{ section.id }} .section--container .section--body .info-boxes .info-box .info-box-inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-flow: column nowrap;
    gap: 16px;
}
#{{ section.id }} .section--container .section--body .info-boxes .info-box .info-box-inner .info-box-icon {
    width: 100%;
    max-width: 76px;
    height: 76px;
    margin-bottom: 8px;
}
#{{ section.id }} .section--container .section--body .info-boxes .info-box .info-box-inner h3 {
    font-size: var(--text-1);
}
#{{ section.id }} .section--container .section--body .info-boxes .info-box .info-box-inner .info-box-content {
    display: flex;
    flex-flow: column nowrap;
    gap: 16px;
}
#{{ section.id }} .section--container .section--body .info-boxes .info-box .info-box-inner .info-box-content * {
    color: var(--color-black);
}
#{{ section.id }} .section--container .section--body .section--body-content {
    position: relative;
}
#{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner {
    height: 100%;
    position: relative;
    border-radius: 60px;
    background: var(--color-black);
    border-radius: 60px;
    overflow: hidden;
    background-size: cover;
    background-position: bottom center;
    background-repeat: no-repeat;
}
#{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-flow: column nowrap;
    justify-content: flex-end;
    padding: 60px;
}
#{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content .section--body-content-inner-content-inner {
    display: flex;
    flex-flow: row nowrap;
    gap: 24px;
    align-items: center;
}
#{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content .section--body-content-inner-content-inner .section--body-content-inner-content-icon {
    width: 100%;
    max-width: 76px;
    height: 76px;
}
#{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content .section--body-content-inner-content-inner .section--body-content-inner-content-header {
    display: flex;
    flex-flow: column nowrap;
    gap: 16px;
}
#{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content .section--body-content-inner-content-inner .section--body-content-inner-content-header h3 {
    font-size: var(--text-2);   
    color: var(--color-white);
    margin: 0;
}
#{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content .section--body-content-inner-content-inner .section--body-content-inner-content-content {
    display: flex;
    flex-flow: column nowrap;
    gap: 16px;
}
#{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content .section--body-content-inner-content-inner .section--body-content-inner-content-content * {
    color: var(--color-white);
}
@media only screen and (max-width: 1279px) {
    #{{ section.id }} .section--container {
        gap: 40px;
    }
    #{{ section.id }} .section--container .section--body {
        gap: 24px;
    }
    #{{ section.id }} .section--container .section--body .section--body-content {
        max-width: calc(50% - (24px * 1 / 2));
    }
}
@media only screen and (max-width: 991px) {
    #{{ section.id }} .section--container .section--body .info-boxes .info-box {
        padding: 32px 20px;
    }
    #{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content {
        padding: 40px;
    }
}
@media only screen and (max-width: 767px) {
    #{{ section.id }} .section--container .section--body {
        flex-flow: column-reverse nowrap;
    }
    #{{ section.id }} .section--container .section--body .section--body-content {
        max-width: 100%;
    }
    #{{ section.id }} .section--container .section--body .info-boxes .info-box {
        max-width: 100%;
    }
    #{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content {
        position: relative;
        padding-top: 56.25%;
    }
    #{{ section.id }} .section--container .section--body .section--body-content .section--body-content-inner .section--body-content-inner-content .section--body-content-inner-content-inner {
        flex-flow: column nowrap;
        gap: 24px;
        align-items: flex-start;
    }
}
{% endstyle %}

