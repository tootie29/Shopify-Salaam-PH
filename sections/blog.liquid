{% comment %}
  Blog template main section: a branded banner with the blog title, then a
  3-column grid of article cards with a progressively-enhanced "Load more"
  button (assets/blog.js). No pagination — load more appends the next batch.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{%- assign per_page = section.settings.posts_per_page | default: 9 -%}
{%- assign banner_title = section.settings.heading | default: blog.title -%}

{% paginate blog.articles by per_page %}
  <section
    id="{{ section.id }}"
    data-section-id="{{ section.id }}"
    data-section-type="blog-posts"
    class="blog-posts"
  >
    {% comment %} -------- Banner -------- {% endcomment %}
    <div class="blog-posts__banner">
      <div class="section--container">
        <p class="blog-posts__banner-title">{{ banner_title }}</p>
        <nav class="blog-posts__path" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">|</span>
          <span class="blog-posts__current">{{ banner_title }}</span>
        </nav>
      </div>
    </div>

    <div class="section--container">
      <div class="blog-posts__grid" data-blog-grid>
        {% for article in blog.articles %}
          <article class="blog-card" data-blog-item>
            <a class="blog-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {% if article.image %}
                {{
                  article.image
                  | image_url: width: 800
                  | image_tag:
                    widths: '300, 400, 600, 800',
                    sizes: '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw',
                    loading: 'lazy',
                    class: 'blog-card__img',
                    alt: article.title
                }}
              {% else %}
                <div class="blog-card__img blog-card__img--placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <div class="blog-card__body">
              <div class="blog-card__meta">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%b %d, %Y' }}
                </time>
              </div>

              <h3 class="blog-card__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>

              {% if article.excerpt_or_content != blank %}
                <div class="blog-card__excerpt">
                  {{ article.excerpt_or_content | strip_html | truncatewords: 24 }}
                </div>
              {% endif %}

              <a class="blog-card__link" href="{{ article.url }}">
                {{ section.settings.read_more_text | default: 'Read more' }}
              </a>
            </div>
          </article>
        {% else %}
          <p class="blog-posts__empty">{{ 'blog.no_articles' | t }}</p>
        {% endfor %}
      </div>

      {% if paginate.next %}
        <div class="blog-posts__loadmore">
          <a
            class="btn btn--black blog-posts__loadmore-btn"
            href="{{ paginate.next.url }}"
            data-blog-loadmore
            data-label="{{ section.settings.load_more_text | default: 'Load more' }}"
          >
            {{ section.settings.load_more_text | default: 'Load more' }}
          </a>
        </div>
      {% endif %}
    </div>
  </section>
{% endpaginate %}

<script src="{{ 'blog.js' | asset_url }}" defer></script>

{% style %}
  /* Full-bleed section; inner containers stay at page width */
  #{{ section.id }} {
    width: 100%;
  }
  #{{ section.id }} .section--container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  /* Banner */
  #{{ section.id }} .blog-posts__banner {
    background-color: var(--color-red);
    color: var(--color-white);
    padding: 22px 0;
    margin-bottom: 48px;
  }
  #{{ section.id }} .blog-posts__banner-title {
    margin: 0 0 6px;
    font-size: var(--text-3);
    font-weight: var(--font-primary-weight-bold);
    line-height: 1;
    color: var(--color-white);
  }
  #{{ section.id }} .blog-posts__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-medium);
  }
  #{{ section.id }} .blog-posts__path a {
    color: var(--color-white);
    text-decoration: none;
    opacity: 0.92;
  }
  #{{ section.id }} .blog-posts__path a:hover {
    text-decoration: underline;
  }
  #{{ section.id }} .blog-posts__path span {
    opacity: 0.75;
  }
  #{{ section.id }} .blog-posts__current {
    font-weight: var(--font-primary-weight-bold);
  }

  /* Grid */
  #{{ section.id }} .blog-posts__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-bottom: 8px;
  }
  #{{ section.id }} .blog-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  #{{ section.id }} .blog-card:hover {
    border-color: var(--color-red);
    transform: translateY(-4px);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.1);
  }
  #{{ section.id }} .blog-card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #f1f1f1;
  }
  #{{ section.id }} .blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  #{{ section.id }} .blog-card:hover .blog-card__img {
    transform: scale(1.04);
  }
  #{{ section.id }} .blog-card__img--placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #{{ section.id }} .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 26px;
    flex: 1 1 auto;
  }
  #{{ section.id }} .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-medium);
    color: rgba(0, 0, 0, 0.55);
  }
  #{{ section.id }} .blog-card__title {
    margin: 0;
    font-size: var(--text-1);
    font-weight: var(--font-primary-weight-bold);
    line-height: 1.25;
  }
  #{{ section.id }} .blog-card__title a {
    color: var(--color-black);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  #{{ section.id }} .blog-card__title a:hover {
    color: var(--color-red);
  }
  #{{ section.id }} .blog-card__excerpt {
    font-size: var(--text--1);
    line-height: 1.5;
    color: rgba(0, 0, 0, 0.7);
  }
  #{{ section.id }} .blog-card__link {
    margin-top: auto;
    padding-top: 6px;
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-bold);
    color: var(--color-red);
    text-decoration: none;
  }
  #{{ section.id }} .blog-card__link:hover {
    text-decoration: underline;
  }
  #{{ section.id }} .blog-posts__loadmore {
    display: flex;
    justify-content: center;
    margin-top: 40px;
    padding-bottom: 56px;
  }
  #{{ section.id }} .blog-posts__loadmore-btn[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }
  #{{ section.id }} .blog-posts__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: rgba(0, 0, 0, 0.6);
    padding: 40px 0 56px;
  }

  @media (max-width: 1023px) {
    #{{ section.id }} .blog-posts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
    #{{ section.id }} .blog-posts__banner {
      margin-bottom: 36px;
    }
  }
  @media (max-width: 767px) {
    #{{ section.id }} .blog-posts__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Banner title (defaults to blog title)"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts per load",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "text",
      "id": "load_more_text",
      "label": "Load more button text",
      "default": "Load more"
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more link text",
      "default": "Read more"
    }
  ]
}
{% endschema %}
