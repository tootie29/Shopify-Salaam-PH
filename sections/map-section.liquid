<section
	id="{{ section.id }}"
	data-section-id="{{ section.id }}"
	data-section-type="map-section"
	class="section map-section"
	{% if section.settings.background_color != blank %}
		style="background-color: {{ section.settings.background_color }};"
	{% endif %}
>
	<div class="section--container">
		{% if section.settings.title != blank %}
			<h2 class="map-section--title">{{ section.settings.title }}</h2>
		{% endif %}

		<div class="map-section--map">
			{% if section.settings.map_embed_code != blank %}
				{{ section.settings.map_embed_code }}
			{% else %}
				{%- assign map_query = section.settings.map_query | default: 'Katipunan, Quezon City' | url_encode -%}
				<iframe
					class="map-section--iframe"
					src="https://maps.google.com/maps?q={{ map_query }}&z=15&output=embed"
					title="{{ section.settings.title | default: 'Map' | escape }}"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					allowfullscreen
				></iframe>
			{% endif %}
		</div>
	</div>
</section>

{% style %}
	#{{ section.id }} .section--container {
		display: flex;
		flex-flow: column nowrap;
		align-items: flex-start;
		gap: 24px;
	}
	#{{ section.id }} .section--container .map-section--title {
		margin: 0;
		color: {{ section.settings.text_color | default: '#000000' }};
	}
	#{{ section.id }} .section--container .map-section--map {
		position: relative;
		width: 100%;
		height: {{ section.settings.map_height | default: 420 }}px;
		border-radius: {{ section.settings.corner_radius | default: 24 }}px;
		overflow: hidden;
		border: 1px solid #d5d5d5;
		background-color: #e5e5e5;
	}
	#{{ section.id }} .section--container .map-section--map iframe,
	#{{ section.id }} .section--container .map-section--map .map-section--iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	@media only screen and (max-width: 767px) {
		#{{ section.id }} .section--container {
			gap: 16px;
		}
		#{{ section.id }} .section--container .map-section--map {
			height: {{ section.settings.map_height_mobile | default: 320 }}px;
		}
	}
{% endstyle %}

{% schema %}
{
	"name": "Map",
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Find us on the map"
		},
		{
			"type": "header",
			"content": "Map"
		},
		{
			"type": "textarea",
			"id": "map_embed_code",
			"label": "Google Maps embed code",
			"info": "In Google Maps: Share → Embed a map → copy the <iframe> code and paste it here. Leave blank to use the location below."
		},
		{
			"type": "text",
			"id": "map_query",
			"label": "Fallback location",
			"info": "Used only when no embed code is pasted above. Enter an address or place name.",
			"default": "Katipunan, Quezon City"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "range",
			"id": "map_height",
			"label": "Map height (desktop)",
			"min": 240,
			"max": 720,
			"step": 20,
			"unit": "px",
			"default": 420
		},
		{
			"type": "range",
			"id": "map_height_mobile",
			"label": "Map height (mobile)",
			"min": 200,
			"max": 560,
			"step": 20,
			"unit": "px",
			"default": 320
		},
		{
			"type": "range",
			"id": "corner_radius",
			"label": "Corner radius",
			"min": 0,
			"max": 48,
			"step": 2,
			"unit": "px",
			"default": 24
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Title",
			"default": "#000000"
		}
	],
	"presets": [
		{
			"name": "Map"
		}
	]
}
{% endschema %}
