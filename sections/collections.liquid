{% comment %}
  list-collections template main section: a branded banner and a grid of
  collection cards linking to each collection page.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<section
  id="{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="collections-list"
  class="collections-list"
>
  <div class="collections-list__banner">
    <div class="section--container">
      <p class="collections-list__title">{{ section.settings.heading | default: 'Our Menu' }}</p>
      <nav class="collections-list__path" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">|</span>
        <span class="collections-list__current">{{ section.settings.heading | default: 'Our Menu' }}</span>
      </nav>
    </div>
  </div>

  <div class="section--container">
    {% if collections.size > 0 %}
      <div class="collections-list__grid">
        {% for collection in collections %}
          {%- assign card_image = collection.featured_image | default: collection.products.first.featured_image -%}
          <a class="collections-list__card" href="{{ collection.url }}">
            <div class="collections-list__media">
              {% if card_image %}
                {{
                  card_image
                  | image_url: width: 700
                  | image_tag:
                    widths: '300, 450, 600, 700',
                    sizes: '(max-width: 767px) 90vw, 33vw',
                    loading: 'lazy',
                    class: 'collections-list__image',
                    alt: collection.title
                }}
              {% else %}
                <div class="collections-list__image collections-list__image--placeholder">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <span class="collections-list__overlay"></span>
              <div class="collections-list__caption">
                <h3 class="collections-list__name">{{ collection.title }}</h3>
                {% if section.settings.show_count %}
                  <span class="collections-list__count">
                    {{ collection.all_products_count }}
                    {% if collection.all_products_count == 1 %}item{% else %}items{% endif %}
                  </span>
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p class="collections-list__empty">No collections yet.</p>
    {% endif %}
  </div>
</section>

{% style %}
  /* Full-bleed section; inner containers stay at page width */
  #{{ section.id }} {
    width: 100%;
  }
  #{{ section.id }} .section--container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  /* Banner */
  #{{ section.id }} .collections-list__banner {
    background-color: var(--color-red);
    color: var(--color-white);
    padding: 22px 0;
    margin-bottom: 40px;
  }
  #{{ section.id }} .collections-list__title {
    margin: 0 0 6px;
    font-size: var(--text-3);
    font-weight: var(--font-primary-weight-bold);
    line-height: 1;
    color: var(--color-white);
  }
  #{{ section.id }} .collections-list__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-medium);
  }
  #{{ section.id }} .collections-list__path a {
    color: var(--color-white);
    text-decoration: none;
    opacity: 0.92;
  }
  #{{ section.id }} .collections-list__path a:hover {
    text-decoration: underline;
  }
  #{{ section.id }} .collections-list__path span {
    opacity: 0.75;
  }
  #{{ section.id }} .collections-list__current {
    font-weight: var(--font-primary-weight-bold);
  }

  /* Grid */
  #{{ section.id }} .collections-list__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    padding-bottom: 24px;
  }
  #{{ section.id }} .collections-list__card {
    display: block;
    text-decoration: none;
    border-radius: 24px;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.22s ease, transform 0.22s ease, box-shadow 0.22s ease;
  }
  #{{ section.id }} .collections-list__card:hover {
    border-color: var(--color-red);
    transform: translateY(-4px);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.12);
  }
  #{{ section.id }} .collections-list__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #f3f0f0;
    overflow: hidden;
  }
  #{{ section.id }} .collections-list__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  #{{ section.id }} .collections-list__image--placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #{{ section.id }} .collections-list__card:hover .collections-list__image {
    transform: scale(1.05);
  }
  #{{ section.id }} .collections-list__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0) 70%);
  }
  #{{ section.id }} .collections-list__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  #{{ section.id }} .collections-list__name {
    margin: 0;
    font-size: var(--text-2);
    font-weight: var(--font-primary-weight-bold);
    line-height: 1.1;
    color: var(--color-white);
  }
  #{{ section.id }} .collections-list__count {
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-medium);
    color: rgba(255, 255, 255, 0.85);
  }
  #{{ section.id }} .collections-list__empty {
    text-align: center;
    padding: 40px 0;
    color: rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 991px) {
    #{{ section.id }} .collections-list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media (max-width: 575px) {
    #{{ section.id }} .collections-list__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Banner title",
      "default": "Our Menu"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    }
  ],
  "presets": [{ "name": "Collections list" }]
}
{% endschema %}
