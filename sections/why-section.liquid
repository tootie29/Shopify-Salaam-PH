<section
	id="{{ section.id }}"
	data-section-id="{{ section.id }}"
	data-section-type="why-section"
	class="section why-section"
	{% if section.settings.background_color != blank %}
		style="background-color: {{ section.settings.background_color }};"
	{% endif %}
>
	<div class="section--container">
		{% if section.settings.title != blank %}
			<h2 class="why-section--title">{{ section.settings.title }}</h2>
		{% endif %}

		{% if section.settings.description != blank %}
			<div class="why-section--description">{{ section.settings.description }}</div>
		{% endif %}

		<div class="why-section--row">
			{% for block in section.blocks %}
				<div class="why-section--card" {{ block.shopify_attributes }}>
					<span class="why-section--icon">
						{% if block.settings.icon != blank %}
							{{ block.settings.icon | image_url: width: 152 | image_tag: alt: block.settings.heading, loading: 'lazy', class: 'why-section--icon-image' }}
						{% else %}
							<svg class="why-section--icon-check" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
								<path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
							</svg>
						{% endif %}
					</span>

					{% if block.settings.heading != blank %}
						<h3 class="why-section--card-heading">{{ block.settings.heading }}</h3>
					{% endif %}
					{% if block.settings.body != blank %}
						<div class="why-section--card-body">{{ block.settings.body }}</div>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	</div>
</section>

{% style %}
	#{{ section.id }} .section--container {
		display: flex;
		flex-flow: column nowrap;
		align-items: flex-start;
		gap: 40px;
	}
	#{{ section.id }} .section--container .why-section--title {
		margin: 0;
		color: {{ section.settings.text_color | default: '#000000' }};
	}
	#{{ section.id }} .section--container .why-section--description,
	#{{ section.id }} .section--container .why-section--description * {
		font-size: var(--text-1);
		font-weight: var(--font-primary-weight-medium);
		color: {{ section.settings.text_color | default: '#000000' }};
		max-width: 900px;
		margin-top: -16px;
	}
	#{{ section.id }} .section--container .why-section--row {
		display: flex;
		flex-flow: row wrap;
		align-items: stretch;
		gap: 40px;
		width: 100%;
	}
	#{{ section.id }} .section--container .why-section--card {
		flex: 1 1 280px;
		min-width: 0;
		display: flex;
		flex-flow: column nowrap;
		align-items: flex-start;
		gap: 20px;
		padding: 36px;
		border-radius: 40px;
		background-color: {{ section.settings.card_background_color | default: '#FFFFFF' }};
		box-shadow: 0 25px 27.7px rgba(0, 0, 0, 0.05);
	}
	#{{ section.id }} .section--container .why-section--card .why-section--icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		width: 76px;
		height: 76px;
		border-radius: 50%;
		overflow: hidden;
		background-color: {{ section.settings.icon_background_color | default: '#D90000' }};
		color: {{ section.settings.icon_color | default: '#FFFFFF' }};
	}
	#{{ section.id }} .section--container .why-section--card .why-section--icon .why-section--icon-check {
		width: 34px;
		height: 34px;
	}
	#{{ section.id }} .section--container .why-section--card .why-section--icon .why-section--icon-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	#{{ section.id }} .section--container .why-section--card .why-section--card-heading {
		margin: 0;
		font-size: var(--text-1);
		font-weight: var(--font-primary-weight-bold);
		color: {{ section.settings.text_color | default: '#000000' }};
	}
	#{{ section.id }} .section--container .why-section--card .why-section--card-body,
	#{{ section.id }} .section--container .why-section--card .why-section--card-body * {
		font-size: var(--text-0);
		font-weight: var(--font-primary-weight-medium);
		line-height: 1.4;
		color: {{ section.settings.text_color | default: '#000000' }};
	}
	#{{ section.id }} .section--container .why-section--card .why-section--card-body > * {
		margin: 0;
	}

	@media only screen and (max-width: 767px) {
		#{{ section.id }} .section--container {
			gap: 24px;
		}
		#{{ section.id }} .section--container .why-section--description,
		#{{ section.id }} .section--container .why-section--description * {
			margin-top: -8px;
		}
		#{{ section.id }} .section--container .why-section--row {
			flex-flow: column nowrap;
			gap: 16px;
		}
		#{{ section.id }} .section--container .why-section--card {
			width: 100%;
			padding: 28px;
		}
	}
{% endstyle %}

{% schema %}
{
	"name": "Why",
	"max_blocks": 6,
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Why Salaam in Katipunan"
		},
		{
			"type": "richtext",
			"id": "description",
			"label": "Description",
			"default": "<p>Three reasons students, faculty, and families keep ordering from our Loyola Heights kitchen.</p>"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "card_background_color",
			"label": "Card background",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "icon_background_color",
			"label": "Icon background",
			"default": "#D90000"
		},
		{
			"type": "color",
			"id": "icon_color",
			"label": "Icon color",
			"default": "#FFFFFF"
		}
	],
	"blocks": [
		{
			"type": "reason",
			"name": "Reason",
			"settings": [
				{
					"type": "image_picker",
					"id": "icon",
					"label": "Icon image",
					"info": "Optional. Leave blank to use the default check icon."
				},
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "Reason heading"
				},
				{
					"type": "richtext",
					"id": "body",
					"label": "Body",
					"default": "<p>Short supporting sentence for this reason.</p>"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Why",
			"blocks": [
				{
					"type": "reason",
					"settings": {
						"heading": "Walking distance from Ateneo",
						"body": "<p>Two-minute walk from Gate 2.5. Lunchtime crowd, dinner study sessions.</p>"
					}
				},
				{
					"type": "reason",
					"settings": {
						"heading": "Student-friendly prices",
						"body": "<p>Premium toppings without the luxury price tag. Same recipe as our main branch.</p>"
					}
				},
				{
					"type": "reason",
					"settings": {
						"heading": "Hot in under 45 minutes",
						"body": "<p>Direct delivery across Loyola Heights, UP Diliman, and Miriam.</p>"
					}
				}
			]
		}
	]
}
{% endschema %}
