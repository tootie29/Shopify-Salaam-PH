
{% assign featured_collection = section.settings.collection %}
{% if featured_collection == blank and section.settings.collection != blank %}
  {%- comment -%}
    Resolve handle fallback if the setting returns a handle instead of an object.
  {%- endcomment -%}
  {% assign featured_collection = collections[section.settings.collection] %}
{% endif %}
{% assign products_limit = section.settings.products_to_show | default: 8 %}

<section
  id="order-now"
  data-section-id="{{ section.id }}"
  data-section-type="grid-section"
  class="section grid-section"
>
	<div class="section--container">
		{% if section.settings.title != blank or section.settings.see_more_link != blank %}
			<div class="section--header">
				{% if section.settings.title != blank %}
					<h2>{{ section.settings.title }}</h2>
				{% endif %}
                {% if section.settings.description != blank %}
                    <div class="section--description">{{ section.settings.description }}</div>
                {% endif %}
			</div>
		{% endif %}

		<div class="section--body">
			{% if featured_collection and featured_collection.products_count > 0 %}
				<div class="best-seller-items">
					{% for product in featured_collection.products limit: products_limit %}
            {% assign featured_image = product.featured_image %}
            {% assign product_variant = product.first_available_variant | default: product.variants.first %}
							<div
                class="best-seller-item"
                data-product-title="{{ product.title | escape }}"
                data-product-description="{{ product.description | strip_html | escape }}"
                data-product-image="{% if featured_image %}{{ featured_image | image_url: width: 1200 }}{% endif %}"
                data-variant-id="{{ product_variant.id }}"
                data-product-variants='{{ product.variants | json | escape }}'
              >
                <div class="best-seller-item-inner">
                  {% if featured_image %}
                      <div class="best-seller-item--image-wrapper">
                          {{ featured_image | image_url: width: 1000 | image_tag: class: 'best-seller-item--image-image', loading: 'lazy', alt: product.title }}
                      </div>
                  {% else %}
                      <div class="best-seller-item--image-wrapper best-seller-item--image-wrapper-placeholder">
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                  {% endif %}
                  <div class="best-seller-item--content">
                        <div class="best-seller-item-price">
                            <div class="star-rating">
                                <svg width="100" height="20" viewBox="0 0 100 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M49.0489 2.92705C49.3483 2.00574 50.6517 2.00574 50.9511 2.92705L52.0206 6.21885C52.1545 6.63087 52.5385 6.90983 52.9717 6.90983H56.4329C57.4016 6.90983 57.8044 8.14945 57.0207 8.71885L54.2205 10.7533C53.87 11.0079 53.7234 11.4593 53.8572 11.8713L54.9268 15.1631C55.2261 16.0844 54.1717 16.8506 53.388 16.2812L50.5878 14.2467C50.2373 13.9921 49.7627 13.9921 49.4122 14.2467L46.612 16.2812C45.8283 16.8506 44.7739 16.0844 45.0732 15.1631L46.1428 11.8713C46.2766 11.4593 46.13 11.0079 45.7795 10.7533L42.9793 8.71885C42.1956 8.14945 42.5984 6.90983 43.5671 6.90983H47.0283C47.4615 6.90983 47.8455 6.63087 47.9794 6.21885L49.0489 2.92705Z" fill="#F5DA40"/>
                                    <path d="M29.0489 2.92705C29.3483 2.00574 30.6517 2.00574 30.9511 2.92705L32.0206 6.21885C32.1545 6.63087 32.5385 6.90983 32.9717 6.90983H36.4329C37.4016 6.90983 37.8044 8.14945 37.0207 8.71885L34.2205 10.7533C33.87 11.0079 33.7234 11.4593 33.8572 11.8713L34.9268 15.1631C35.2261 16.0844 34.1717 16.8506 33.388 16.2812L30.5878 14.2467C30.2373 13.9921 29.7627 13.9921 29.4122 14.2467L26.612 16.2812C25.8283 16.8506 24.7739 16.0844 25.0732 15.1631L26.1428 11.8713C26.2766 11.4593 26.13 11.0079 25.7795 10.7533L22.9793 8.71885C22.1956 8.14945 22.5984 6.90983 23.5671 6.90983H27.0283C27.4615 6.90983 27.8455 6.63087 27.9794 6.21885L29.0489 2.92705Z" fill="#F5DA40"/>
                                    <path d="M9.04894 2.92705C9.3483 2.00574 10.6517 2.00574 10.9511 2.92705L12.0206 6.21885C12.1545 6.63087 12.5385 6.90983 12.9717 6.90983H16.4329C17.4016 6.90983 17.8044 8.14945 17.0207 8.71885L14.2205 10.7533C13.87 11.0079 13.7234 11.4593 13.8572 11.8713L14.9268 15.1631C15.2261 16.0844 14.1717 16.8506 13.388 16.2812L10.5878 14.2467C10.2373 13.9921 9.7627 13.9921 9.41221 14.2467L6.61204 16.2812C5.82833 16.8506 4.77385 16.0844 5.0732 15.1631L6.14277 11.8713C6.27665 11.4593 6.12999 11.0079 5.7795 10.7533L2.97933 8.71885C2.19562 8.14945 2.59839 6.90983 3.56712 6.90983H7.02832C7.46154 6.90983 7.8455 6.63087 7.97937 6.21885L9.04894 2.92705Z" fill="#F5DA40"/>
                                    <path d="M69.0489 2.92705C69.3483 2.00574 70.6517 2.00574 70.9511 2.92705L72.0206 6.21885C72.1545 6.63087 72.5385 6.90983 72.9717 6.90983H76.4329C77.4016 6.90983 77.8044 8.14945 77.0207 8.71885L74.2205 10.7533C73.87 11.0079 73.7234 11.4593 73.8572 11.8713L74.9268 15.1631C75.2261 16.0844 74.1717 16.8506 73.388 16.2812L70.5878 14.2467C70.2373 13.9921 69.7627 13.9921 69.4122 14.2467L66.612 16.2812C65.8283 16.8506 64.7739 16.0844 65.0732 15.1631L66.1428 11.8713C66.2766 11.4593 66.13 11.0079 65.7795 10.7533L62.9793 8.71885C62.1956 8.14945 62.5984 6.90983 63.5671 6.90983H67.0283C67.4615 6.90983 67.8455 6.63087 67.9794 6.21885L69.0489 2.92705Z" fill="#F5DA40"/>
                                    <path d="M89.0489 2.92705C89.3483 2.00574 90.6517 2.00574 90.9511 2.92705L92.0206 6.21885C92.1545 6.63087 92.5385 6.90983 92.9717 6.90983H96.4329C97.4016 6.90983 97.8044 8.14945 97.0207 8.71885L94.2205 10.7533C93.87 11.0079 93.7234 11.4593 93.8572 11.8713L94.9268 15.1631C95.2261 16.0844 94.1717 16.8506 93.388 16.2812L90.5878 14.2467C90.2373 13.9921 89.7627 13.9921 89.4122 14.2467L86.612 16.2812C85.8283 16.8506 84.7739 16.0844 85.0732 15.1631L86.1428 11.8713C86.2766 11.4593 86.13 11.0079 85.7795 10.7533L82.9793 8.71885C82.1956 8.14945 82.5984 6.90983 83.5671 6.90983H87.0283C87.4615 6.90983 87.8455 6.63087 87.9794 6.21885L89.0489 2.92705Z" fill="#F5DA40"/>
                                </svg>
                            </div>
                            
                        </div>
                      {% if product.title != blank %}
                          <h3>{{ product.title }}</h3>
                      {% endif %}

                      {% if product.description != blank %}
                          <div class="best-seller-item--description">{{ product.description }}</div>
                      {% endif %}
                      {% comment %} <div class="best-seller-item-price-value">{{ product.price | money }}</div> {% endcomment %}

                  </div>
                </div>
							</div>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</div>

  <div class="product-modal" aria-hidden="true">
    <div class="product-modal__backdrop"></div>
    <div class="product-modal__dialog" role="dialog" aria-modal="true">
      <button type="button" class="product-modal__close" aria-label="Close">&times;</button>
      <div class="product-modal__content">
        <div class="product-modal__image"></div>
        <div class="product-modal__details">
          <div class="product-modal__rating">
            <svg width="100" height="20" viewBox="0 0 100 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M49.0489 2.92705C49.3483 2.00574 50.6517 2.00574 50.9511 2.92705L52.0206 6.21885C52.1545 6.63087 52.5385 6.90983 52.9717 6.90983H56.4329C57.4016 6.90983 57.8044 8.14945 57.0207 8.71885L54.2205 10.7533C53.87 11.0079 53.7234 11.4593 53.8572 11.8713L54.9268 15.1631C55.2261 16.0844 54.1717 16.8506 53.388 16.2812L50.5878 14.2467C50.2373 13.9921 49.7627 13.9921 49.4122 14.2467L46.612 16.2812C45.8283 16.8506 44.7739 16.0844 45.0732 15.1631L46.1428 11.8713C46.2766 11.4593 46.13 11.0079 45.7795 10.7533L42.9793 8.71885C42.1956 8.14945 42.5984 6.90983 43.5671 6.90983H47.0283C47.4615 6.90983 47.8455 6.63087 47.9794 6.21885L49.0489 2.92705Z" fill="#F5DA40"/>
              <path d="M29.0489 2.92705C29.3483 2.00574 30.6517 2.00574 30.9511 2.92705L32.0206 6.21885C32.1545 6.63087 32.5385 6.90983 32.9717 6.90983H36.4329C37.4016 6.90983 37.8044 8.14945 37.0207 8.71885L34.2205 10.7533C33.87 11.0079 33.7234 11.4593 33.8572 11.8713L34.9268 15.1631C35.2261 16.0844 34.1717 16.8506 33.388 16.2812L30.5878 14.2467C30.2373 13.9921 29.7627 13.9921 29.4122 14.2467L26.612 16.2812C25.8283 16.8506 24.7739 16.0844 25.0732 15.1631L26.1428 11.8713C26.2766 11.4593 26.13 11.0079 25.7795 10.7533L22.9793 8.71885C22.1956 8.14945 22.5984 6.90983 23.5671 6.90983H27.0283C27.4615 6.90983 27.8455 6.63087 27.9794 6.21885L29.0489 2.92705Z" fill="#F5DA40"/>
