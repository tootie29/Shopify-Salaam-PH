              <path d="M69.0489 2.92705C69.3483 2.00574 70.6517 2.00574 70.9511 2.92705L72.0206 6.21885C72.1545 6.63087 72.5385 6.90983 72.9717 6.90983H76.4329C77.4016 6.90983 77.8044 8.14945 77.0207 8.71885L74.2205 10.7533C73.87 11.0079 73.7234 11.4593 73.8572 11.8713L74.9268 15.1631C75.2261 16.0844 74.1717 16.8506 73.388 16.2812L70.5878 14.2467C70.2373 13.9921 69.7627 13.9921 69.4122 14.2467L66.612 16.2812C65.8283 16.8506 64.7739 16.0844 65.0732 15.1631L66.1428 11.8713C66.2766 11.4593 66.13 11.0079 65.7795 10.7533L62.9793 8.71885C62.1956 8.14945 62.5984 6.90983 63.5671 6.90983H67.0283C67.4615 6.90983 67.8455 6.63087 67.9794 6.21885L69.0489 2.92705Z" fill="#F5DA40"/>
