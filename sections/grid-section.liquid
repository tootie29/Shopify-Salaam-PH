          </div>
          <h3 class="product-modal__title"></h3>
          <div class="product-modal__description"></div>
          <div class="product-modal__price"></div>

          <div class="product-modal__variant">
            <span class="product-modal__variant-label">Variant</span>
            <div class="product-modal__variant-options" role="radiogroup" aria-label="Select variant"></div>
          </div>

          <div class="product-modal__quantity">
            <button type="button" class="product-modal__qty-btn" data-action="decrement">-</button>
            <input type="number" min="1" value="1" class="product-modal__qty-input" aria-label="Quantity">
            <button type="button" class="product-modal__qty-btn" data-action="increment">+</button>
          </div>

          <button type="button" class="product-modal__add btn btn--black">Add to cart</button>
        </div>
      </div>
    </div>
  </div>
</section>



{% schema %}
  {
  "name": "Grid Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Grid Section"
    }
  ]
}  
{% endschema %}

{% style %}
#order-now {
    background-color: #F3F0F0;
}
#order-now .section--container {
    display: flex;
    flex-flow: column nowrap;
    gap: 60px;
}
#order-now .section--container .section--header {
    display: flex;
    flex-flow: column nowrap;
    justify-content: center;
    align-items: center;
    gap: 16px;
}
#order-now .section--container .section--header h2 {
  margin: 0;
  text-align: center;
}
#order-now .section--container .section--header .section--description {
  text-align: center;
  color: var(--color-black);
}
#order-now .section--container .section--header .btn {
  padding: 0!important;
  color: var(--color-red);
  background: transparent;
  max-width: fit-content;
}
#order-now .section--container .section--body {
  display: flex;
  flex-flow: row wrap;
  gap: 40px;
  width: 100%;
}
#order-now .section--container .section--body .best-seller-items {
  width: 100%;
  display: flex;
  flex-flow: row wrap;
  gap: 40px;
  justify-content: center;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item {
  width: 100%;
  max-width: calc(25% - (40px * 3 / 4));
  display: flex;
  flex-flow: column nowrap;
  align-items: center;
  padding-top: 65px;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item .best-seller-item-inner {
  padding: 0 32px 48px;
  display: flex;
  flex-flow: column nowrap;
  gap: 24px;
  align-items: center;
  border: 1px solid #D5D5D5;
  border-radius: 60px!important;
  background: #EDEDED82;
  transition: all 0.3s ease;
  width: 100%;
  height: 100%;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item .best-seller-item-inner .best-seller-item--image-wrapper {
  border-radius: 50%;
  padding: 10px;
  width: 100%;
  max-width: 175px;
  height: 130px;
  margin-top: -65px;
  transition: all 0.3s ease;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item .best-seller-item-inner .best-seller-item--content {
  width: 100%;
  display: flex;
  flex-flow: column nowrap;
  align-items: center;
  gap: 24px;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item .best-seller-item-inner .best-seller-item--content h3 {
  font-weight: var(--font-primary-weight-medium);
  font-size: var(--text-2);
  color: var(--color-black);
  margin: 0;
  text-align: center;
  transition: all 0.3s ease;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item .best-seller-item-inner .best-seller-item--content .best-seller-item--description {
  text-align: center;
  font-weight: var(--font-primary-weight);
  font-size: var(--text-0);
  color: var(--color-black);
  margin: 0;
  transition: all 0.3s ease;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item .best-seller-item-inner .best-seller-item--content .best-seller-item-price {
    display: flex;
    flex-flow: row nowrap;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    width: 100%;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item .best-seller-item-inner .best-seller-item--content .best-seller-item-price .best-seller-item-price-value {
    color: var(--color-red);
    font-weight: var(--font-primary-weight-medium);
    transition: all 0.3s ease;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item:hover .best-seller-item--image-wrapper {
  background: var(--color-white);
}
#order-now .section--container .section--body .best-seller-items .best-seller-item:hover .best-seller-item-inner {
  border-color: var(--color-red);
  background: var(--color-red);
}
#order-now .section--container .section--body .best-seller-items .best-seller-item:hover .best-seller-item-inner .best-seller-item--content .best-seller-item-price {
    display: flex;
    flex-flow: row nowrap;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
}
#order-now .section--container .section--body .best-seller-items .best-seller-item:hover .best-seller-item-inner .best-seller-item--content h3 {
  color: var(--color-white);
}
#order-now .section--container .section--body .best-seller-items .best-seller-item:hover .best-seller-item-inner .best-seller-item--content .best-seller-item--description {
  color: var(--color-white);
}
#order-now .section--container .section--body .best-seller-items .best-seller-item:hover .best-seller-item-inner .best-seller-item--content .best-seller-item-price .best-seller-item-price-value {
  color: var(--color-white);
}
/* Modal */
#order-now .product-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
#order-now .product-modal.is-visible {
  display: flex;
}
#order-now .product-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.6);
}
#order-now .product-modal__dialog {
  position: relative;
  background: #fff;
  border-radius: 20px;
  padding: 32px;
  max-width: 960px;
  width: min(90vw, 960px);
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 32px;
  box-shadow: 0 20px 80px rgba(0,0,0,0.2);
  z-index: 1;
  overflow-y: auto;
}
#order-now .product-modal__close {
  position: absolute;
  top: 12px;
  right: 12px;
  background: transparent;
  border: none;
  font-size: 24px;
  cursor: pointer;
}
#order-now .product-modal__dialog {
  width: 100%;
  display: flex;
  flex-flow: column nowrap;
}
#order-now .product-modal__dialog .product-modal__content {
  display: flex;
  flex-flow: row nowrap;
  gap: 100px;
}
#order-now .product-modal__image img,
#order-now .product-modal__image svg {
  width: 100%;
  height: auto;
}
#order-now .product-modal__image {
  width: 100%;
  max-width: 50%;
}
#order-now .product-modal__details {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
#order-now .product-modal__title {
  margin: 0;
  font-size: var(--text-3, 28px);
}
#order-now .product-modal__price {
  font-size: var(--text-1);
  font-weight: var(--font-primary-weight-medium);
  color: var(--color-red);
}
#order-now .product-modal__variant {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-width: 320px;
}
#order-now .product-modal__variant-label {
  font-size: 14px;
  font-weight: var(--font-primary-weight-medium);
}
#order-now .product-modal__variant-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
#order-now .product-modal__variant-option {
  position: relative;
}
#order-now .product-modal__variant-input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
#order-now .product-modal__variant-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border-radius: 999px;
  border: 1px solid rgba(0, 0, 0, 0.14);
  background-color: #fff;
  font-size: 14px;
  font-weight: var(--font-primary-weight-medium);
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
  cursor: pointer;
  transition: all 0.2s ease;
}
#order-now .product-modal__variant-pill::before {
  content: '';
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid rgba(0, 0, 0, 0.25);
  display: inline-block;
