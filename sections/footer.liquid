{%- liquid
  assign social_links = section.blocks | where: 'type', 'social_link'
-%}

<footer
  class="site-footer"
  style="--footer-bg: {{ section.settings.background_color }}; --footer-heading: {{ section.settings.heading_color }}; --footer-text: {{ section.settings.text_color }}; --footer-link-hover: {{ section.settings.link_hover_color }};"
>
  <div class="site-footer__inner">
    <div class="site-footer__columns">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu_column' %}
            <div class="site-footer__col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="site-footer__col-title">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.menu != blank %}
                <ul class="site-footer__col-list">
                  {% for link in block.settings.menu.links %}
                    <li>
                      <a class="site-footer__col-link" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% when 'info_column' %}
            <div class="site-footer__col site-footer__col--info" {{ block.shopify_attributes }}>
              {% if block.settings.logo != blank %}
                <a class="site-footer__info-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
                  {{
                    block.settings.logo
                    | image_url: width: 480
                    | image_tag:
                      widths: '120, 180, 240, 320, 480',
                      sizes: '200px',
                      loading: 'lazy',
                      alt: shop.name
                  }}
                </a>
              {% endif %}
              {% if block.settings.secondary_image != blank %}
                {%- capture footer_secondary_image -%}
                  {{
                    block.settings.secondary_image
                    | image_url: width: 480
                    | image_tag:
                      widths: '120, 180, 240, 320, 480',
                      sizes: '200px',
                      loading: 'lazy',
                      alt: shop.name
                  }}
                {%- endcapture -%}
                {% if block.settings.secondary_image_link != blank %}
                  <a class="site-footer__info-image" href="{{ block.settings.secondary_image_link }}">
                    {{ footer_secondary_image }}
                  </a>
                {% else %}
                  <div class="site-footer__info-image">{{ footer_secondary_image }}</div>
                {% endif %}
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="site-footer__info-text">{{ block.settings.text }}</div>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}

      {% if social_links.size > 0 or section.settings.social_heading != blank %}
        <div class="site-footer__col site-footer__col--social">
          {% if section.settings.social_heading != blank %}
            <h3 class="site-footer__col-title">{{ section.settings.social_heading }}</h3>
          {% endif %}
          <ul class="site-footer__col-list">
            {% for block in social_links %}
              <li {{ block.shopify_attributes }}>
                <a
                  class="site-footer__social-link"
                  href="{{ block.settings.url }}"
                  {% if block.settings.platform != 'phone' and block.settings.platform != 'email' %}target="_blank" rel="noopener"{% endif %}
                >
                  <span class="site-footer__social-icon" aria-hidden="true">
                    {% case block.settings.platform %}
                      {% when 'facebook' %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M13 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h2v6h3v-6h3l1-3h-4v-2c0-.6.4-1 1-1Z"/></svg>
                      {% when 'instagram' %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M12 8.5a3.5 3.5 0 1 0 3.5 3.5A3.5 3.5 0 0 0 12 8.5Zm0 5.7A2.2 2.2 0 1 1 14.2 12 2.2 2.2 0 0 1 12 14.2Zm4.5-8H7.5A3.5 3.5 0 0 0 4 9.7v6.6a3.5 3.5 0 0 0 3.5 3.5h9a3.5 3.5 0 0 0 3.5-3.5V9.7a3.5 3.5 0 0 0-3.5-3.5Zm2.2 10.1a2.2 2.2 0 0 1-2.2 2.2h-9a2.2 2.2 0 0 1-2.2-2.2V9.7a2.2 2.2 0 0 1 2.2-2.2h9a2.2 2.2 0 0 1 2.2 2.2Zm-2.1-7.7a.8.8 0 1 1-.8-.8.8.8 0 0 1 .8.8Z"/></svg>
                      {% when 'twitter' %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-7-6.2 7H1.4l8.2-9.3L1 2h7l4.9 6.5L18.9 2Zm-1.2 18h1.9L7.4 4H5.4l12.3 16Z"/></svg>
                      {% when 'youtube' %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M21.6 7.2a2.8 2.8 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.6.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2 12a29 29 0 0 0 .4 4.8 2.8 2.8 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.8 2.8 0 0 0 2-2A29 29 0 0 0 22 12a29 29 0 0 0-.4-4.8ZM10 15.2V8.8L15.5 12 10 15.2Z"/></svg>
                      {% when 'tiktok' %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M16 3c.3 2 1.6 3.6 3.5 4v2.3c-1.3 0-2.5-.4-3.5-1v6.2a5.5 5.5 0 1 1-5.5-5.5c.3 0 .6 0 .9.1v2.4a3.1 3.1 0 1 0 2.2 3V3H16Z"/></svg>
                      {% when 'linkedin' %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M6.5 9H3v12h3.5V9Zm-1.7-6A2 2 0 1 0 6.8 5 2 2 0 0 0 4.8 3ZM21 14.5c0-3.2-1.7-4.7-4-4.7a3.4 3.4 0 0 0-3 1.6V9H10v12h4v-6c0-1.6.3-3.1 2.2-3.1s1.8 1.7 1.8 3.2V21h3Z"/></svg>
                      {% when 'phone' %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"/></svg>
                      {% when 'email' %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M4 6h16c.6 0 1 .4 1 1v10c0 .6-.4 1-1 1H4c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1Zm1.4 2L12 12.4 18.6 8H5.4Z"/></svg>
                      {% else %}
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm6.9 7h-2.8c-.1-1.5-.4-2.8-.9-3.9A7 7 0 0 1 18.9 10ZM12 5c.8 0 2 1.7 2.4 5H9.6C10 6.7 11.2 5 12 5ZM5.1 14a7 7 0 0 1 0-4h2.8c-.1.6-.1 1.3-.1 2s0 1.4.1 2H5.1Zm.8 2h2.3c.3 1.3.7 2.4 1.2 3.3A7 7 0 0 1 5.9 16Zm3.7-2c-.1-.6-.1-1.3-.1-2s0-1.4.1-2h4.8c.1.6.1 1.3.1 2s0 1.4-.1 2H9.6Zm2.4 5c-.8 0-2-1.7-2.4-5h4.8c-.4 3.3-1.6 5-2.4 5Zm2.7-.7c.5-.9.9-2 1.2-3.3h2.3a7 7 0 0 1-3.5 3.3Z"/></svg>
                    {% endcase %}
                  </span>
                  <span class="site-footer__social-label">{{ block.settings.label }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>

    {% if section.settings.copyright_text != blank %}
      <div class="site-footer__legal">{{ section.settings.copyright_text }}</div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    width: 100%;
    background-color: var(--footer-bg, #fff);
    color: var(--footer-text, #000);
  }

  .site-footer__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 56px 20px 32px;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 40px;
  }

  .site-footer__col-title {
    margin: 0 0 18px;
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-bold);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--footer-heading, #000);
  }

  .site-footer__col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__col-link,
  .site-footer__social-link {
    text-decoration: none;
    color: var(--footer-text, #000);
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-medium);
    transition: color 0.18s ease;
  }

  .site-footer__col-link:hover,
  .site-footer__col-link:focus-visible,
  .site-footer__social-link:hover,
  .site-footer__social-link:focus-visible {
    color: var(--footer-link-hover, #D90000);
  }

  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .site-footer__social-icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .site-footer__social-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .site-footer__col--info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .site-footer__info-logo {
    display: inline-block;
    max-width: 200px;
  }

  .site-footer__info-logo img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .site-footer__info-image {
    display: inline-block;
    max-width: 200px;
  }

  .site-footer__info-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .site-footer__info-text {
    font-size: var(--text--1);
    line-height: 1.55;
    color: var(--footer-text, #000);
  }

  .site-footer__info-text p {
    margin: 0 0 0.6em;
  }

  .site-footer__info-text p:last-child {
    margin-bottom: 0;
  }

  .site-footer__info-text a {
    color: var(--footer-link-hover, #D90000);
    text-decoration: underline;
  }

  .site-footer__legal {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    font-size: var(--text--2);
    color: var(--footer-text, #000);
    opacity: 0.85;
  }

  .site-footer__legal > * {
    margin: 0;
  }

  @media (max-width: 767px) {
    .site-footer__inner {
      padding: 40px 20px 28px;
    }

    .site-footer__columns {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Follow us column"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Heading",
      "default": "Follow Us"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "richtext",
      "id": "copyright_text",
      "label": "Copyright / legal text",
      "default": "<p>© 2026 Salaam Pizza. Katipunan, Quezon City. IDCP-Certified Halal.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Column headings",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Links & text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#D90000"
    }
  ],
  "blocks": [
    {
      "type": "info_column",
      "name": "Logo & text column",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "image_picker",
          "id": "secondary_image",
          "label": "Image below logo"
        },
        {
          "type": "url",
          "id": "secondary_image_link",
          "label": "Image below logo link"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Menu"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            { "value": "facebook", "label": "Facebook" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "twitter", "label": "X (Twitter)" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "linkedin", "label": "LinkedIn" },
            { "value": "phone", "label": "Phone" },
            { "value": "email", "label": "Email" },
            { "value": "website", "label": "Website" }
          ],
          "default": "facebook"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Facebook"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu_column",
          "settings": { "heading": "Order" }
        },
        {
          "type": "menu_column",
          "settings": { "heading": "Visit" }
        },
        {
          "type": "menu_column",
          "settings": { "heading": "Business" }
        },
        {
          "type": "social_link",
          "settings": { "platform": "facebook", "label": "Facebook" }
        },
        {
          "type": "social_link",
          "settings": { "platform": "instagram", "label": "Instagram" }
        },
        {
          "type": "social_link",
          "settings": { "platform": "phone", "label": "0917 300 2540" }
        }
      ]
    }
  ]
}
{% endschema %}
