<section
	id="{{ section.id }}"
	data-section-id="{{ section.id }}"
	data-section-type="delivery-callout-section"
	class="section delivery-callout-section"
	{% if section.settings.background_color != blank %}
		style="background-color: {{ section.settings.background_color }};"
	{% endif %}
>
	<div class="section--container">
		<div class="delivery-callout--card">
			{% if section.settings.tag_text != blank %}
				<div class="delivery-callout--tag-row">
					<span class="delivery-callout--tag">{{ section.settings.tag_text }}</span>
				</div>
			{% endif %}

			{% if section.settings.title != blank %}
				<h2 class="delivery-callout--title">{{ section.settings.title }}</h2>
			{% endif %}

			{% if section.settings.description != blank %}
				<div class="delivery-callout--body">{{ section.settings.description }}</div>
			{% endif %}
		</div>
	</div>
</section>

{% style %}
	#{{ section.id }} .section--container {
		display: flex;
		flex-flow: column nowrap;
		align-items: center;
	}
	#{{ section.id }} .delivery-callout--card {
		width: 100%;
		display: flex;
		flex-flow: column nowrap;
		align-items: flex-start;
		gap: 16px;
		padding: 56px 64px;
		border-radius: {{ section.settings.corner_radius | default: 40 }}px;
		background-color: {{ section.settings.card_background_color | default: '#D90000' }};
		overflow: hidden;
	}
	#{{ section.id }} .delivery-callout--tag {
		display: inline-flex;
		align-items: center;
		padding: 6px 14px;
		border-radius: 53px;
		font-size: var(--text--1);
		font-weight: var(--font-primary-weight-medium);
		line-height: 1;
		text-transform: uppercase;
		background-color: {{ section.settings.tag_background_color | default: '#FFFFFF' }};
		color: {{ section.settings.tag_text_color | default: '#000000' }};
	}
	#{{ section.id }} .delivery-callout--title {
		margin: 0;
		max-width: 1200px;
		font-size: var(--text-4);
		font-weight: var(--font-primary-weight-bold);
		line-height: 1.1;
		color: {{ section.settings.text_color | default: '#FFFFFF' }};
	}
	#{{ section.id }} .delivery-callout--body,
	#{{ section.id }} .delivery-callout--body * {
		max-width: 1200px;
		font-size: var(--text-2);
		font-weight: var(--font-primary-weight-medium);
		line-height: 1.3;
		color: {{ section.settings.text_color | default: '#FFFFFF' }};
	}
	#{{ section.id }} .delivery-callout--body > * {
		margin: 0;
	}

	@media only screen and (max-width: 991px) {
		#{{ section.id }} .delivery-callout--card {
			padding: 48px 40px;
		}
	}
	@media only screen and (max-width: 767px) {
		#{{ section.id }} .delivery-callout--card {
			gap: 14px;
			padding: 32px 24px;
			border-radius: 24px;
		}
		#{{ section.id }} .delivery-callout--title,
		#{{ section.id }} .delivery-callout--body,
		#{{ section.id }} .delivery-callout--body * {
			max-width: 100%;
		}
	}
{% endstyle %}

{% schema %}
{
	"name": "Delivery Callout",
	"settings": [
		{
			"type": "text",
			"id": "tag_text",
			"label": "Tag label",
			"default": "Transparent delivery"
		},
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Delivering to Makati from our Katipunan kitchen."
		},
		{
			"type": "richtext",
			"id": "description",
			"label": "Description",
			"default": "<p>There is no Salaam branch inside Makati yet. Every order placed for a Makati address is baked fresh at 123 Katipunan Avenue, Loyola Heights, then dispatched. Average delivery time is 45 to 60 minutes depending on traffic and the destination barangay.</p>"
		},
		{
			"type": "range",
			"id": "corner_radius",
			"label": "Card corner radius",
			"min": 0,
			"max": 60,
			"step": 2,
			"unit": "px",
			"default": 40
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background",
			"default": "#F6F6F6"
		},
		{
			"type": "color",
			"id": "card_background_color",
			"label": "Card background",
			"default": "#D90000"
		},
		{
			"type": "color",
			"id": "tag_background_color",
			"label": "Tag background",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "tag_text_color",
			"label": "Tag text",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Title & body text",
			"default": "#FFFFFF"
		}
	],
	"presets": [
		{
			"name": "Delivery Callout"
		}
	]
}
{% endschema %}
