{% comment %}
  Product template main section: a breadcrumb bar plus the product details —
  image inside a brand red rounded panel on the left, and rating, title, price,
  description, option dropdowns, and an "Order Now" button on the right.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign menu_label = section.settings.breadcrumb_title | default: 'Menu' -%}

<section
  id="{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="product-main"
  class="product-main"
>
  {% comment %} -------- Breadcrumb bar -------- {% endcomment %}
  <div class="product-breadcrumb">
    <div class="section--container">
      <p class="product-breadcrumb__title">{{ menu_label }}</p>
      <nav class="product-breadcrumb__path" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">|</span>
        <a href="{{ section.settings.menu_url | default: routes.all_products_collection_url }}">{{ menu_label }}</a>
        <span aria-hidden="true">|</span>
        <span class="product-breadcrumb__current">{{ product.title }}</span>
      </nav>
    </div>
  </div>

  <div class="section--container">
    <div class="product-main__card">
      {% comment %} -------- Left: media -------- {% endcomment %}
      <div
        class="product-main__media"
        style="background-color: {{ section.settings.image_background_color | default: '#D90000' }};"
      >
        {% if product.featured_image %}
          {{
            product.featured_image
            | image_url: width: 1000
            | image_tag:
              widths: '300, 500, 700, 1000',
              sizes: '(max-width: 767px) 80vw, 500px',
              loading: 'eager',
              class: 'product-main__image',
              alt: product.featured_image.alt | default: product.title
          }}
        {% else %}
          <div class="product-main__image product-main__image--placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% comment %} -------- Right: info -------- {% endcomment %}
      <div class="product-main__info">
        {% if section.settings.show_rating %}
          <div class="product-main__rating" aria-hidden="true">
            {% for i in (1..5) %}
              <svg viewBox="0 0 24 24" class="product-main__star" focusable="false">
                <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.8 6.1 20.5l1.2-6.5L2.5 9.4 9.1 8.5 12 2.5Z"/>
              </svg>
            {% endfor %}
          </div>
        {% endif %}

        <h1 class="product-main__title">{{ product.title }}</h1>

        {% if section.settings.show_description and product.description != blank %}
          <div class="product-main__description rte">{{ product.description }}</div>
        {% endif %}

        <div class="product-main__price" data-product-price>
          <span class="product-main__price-current" data-price-current>
            {{ current_variant.price | money }}
          </span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <s class="product-main__price-compare" data-price-compare>
              {{ current_variant.compare_at_price | money }}
            </s>
          {% endif %}
        </div>

        {% form 'product', product, class: 'product-main__form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {% unless product.has_only_default_variant %}
            <div class="product-main__options">
              {% for option in product.options_with_values %}
                {%- assign select_id = section.id | append: '-option-' | append: forloop.index0 -%}
                <div class="product-main__option">
                  <label class="product-main__option-label" for="{{ select_id }}">
                    Select your {{ option.name | downcase }}:
                  </label>
                  <div class="product-main__select-wrap">
                    <select
                      class="product-main__select"
                      id="{{ select_id }}"
                      data-option-select
                      data-option-position="{{ forloop.index0 }}"
                    >
                      {% for value in option.values %}
                        <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                          {{ value }}
                        </option>
                      {% endfor %}
                    </select>
                    <svg class="product-main__select-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <button
            type="submit"
            name="add"
            class="product-main__add"
            data-add-btn
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              Order Now
            {% else %}
              Sold Out
            {% endif %}
          </button>
        {% endform %}
      </div>
    </div>

    <script type="application/json" data-product-variants-json>
      {{ product.variants | json }}
    </script>
  </div>
</section>

<script src="{{ 'product-page.js' | asset_url }}" defer></script>

{% style %}
  /* Full-bleed section; inner containers stay at page width */
  #{{ section.id }} {
    width: 100%;
  }
  #{{ section.id }} .section--container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  /* Breadcrumb */
  #{{ section.id }} .product-breadcrumb {
    background-color: var(--color-red);
    color: var(--color-white);
    padding: 22px 0;
    margin-bottom: 48px;
  }
  #{{ section.id }} .product-breadcrumb__title {
    margin: 0 0 6px;
    font-size: var(--text-3);
    font-weight: var(--font-primary-weight-bold);
    line-height: 1;
    color: var(--color-white);
  }
  #{{ section.id }} .product-breadcrumb__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-medium);
  }
  #{{ section.id }} .product-breadcrumb__path a {
    color: var(--color-white);
    text-decoration: none;
    opacity: 0.92;
  }
  #{{ section.id }} .product-breadcrumb__path a:hover {
    text-decoration: underline;
  }
  #{{ section.id }} .product-breadcrumb__path span {
    opacity: 0.75;
  }
  #{{ section.id }} .product-breadcrumb__current {
    font-weight: var(--font-primary-weight-bold);
  }

  /* Card */
  #{{ section.id }} .product-main__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 56px;
    padding-bottom: 64px;
  }

  /* Media */
  #{{ section.id }} .product-main__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 48px;
    box-shadow: 0 21px 36px rgba(0, 0, 0, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  #{{ section.id }} .product-main__image {
    width: 80%;
    height: 80%;
    object-fit: contain;
    display: block;
  }

  /* Info */
  #{{ section.id }} .product-main__info {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  #{{ section.id }} .product-main__rating {
    display: inline-flex;
    gap: 4px;
  }
  #{{ section.id }} .product-main__star {
    width: 22px;
    height: 22px;
    fill: var(--color-red);
  }
  #{{ section.id }} .product-main__title {
    margin: 0;
    font-size: var(--text-4);
    font-weight: var(--font-primary-weight-bold);
    line-height: 1.05;
    color: var(--color-black);
  }
  #{{ section.id }} .product-main__description {
    font-size: var(--text-1);
    line-height: 1.45;
    color: var(--color-black);
    max-width: 660px;
  }
  #{{ section.id }} .product-main__description p {
    margin: 0 0 0.6em;
  }
  #{{ section.id }} .product-main__description p:last-child {
    margin-bottom: 0;
  }
  #{{ section.id }} .product-main__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  #{{ section.id }} .product-main__price-current {
    font-size: var(--text-2);
    font-weight: var(--font-primary-weight-bold);
    color: var(--color-red);
  }
  #{{ section.id }} .product-main__price-compare {
    font-size: var(--text-0);
    font-weight: var(--font-primary-weight-medium);
    color: rgba(0, 0, 0, 0.45);
  }

  /* Options as dropdowns */
  #{{ section.id }} .product-main__options {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 6px 0;
  }
  #{{ section.id }} .product-main__option-label {
    display: block;
    margin-bottom: 10px;
    font-size: var(--text-1);
    font-weight: var(--font-primary-weight-medium);
    color: var(--color-black);
  }
  #{{ section.id }} .product-main__select-wrap {
    position: relative;
    max-width: 660px;
  }
  #{{ section.id }} .product-main__select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    padding: 20px 56px 20px 28px;
    font-family: inherit;
    font-size: var(--text-1);
    font-weight: var(--font-primary-weight-medium);
    color: var(--color-black);
    background-color: #f3f0f0;
    border: 1px solid #b3b3b3;
    border-radius: 200px;
    cursor: pointer;
  }
  #{{ section.id }} .product-main__select:focus {
    outline: none;
    border-color: var(--color-red);
  }
  #{{ section.id }} .product-main__select-caret {
    position: absolute;
    top: 50%;
    right: 26px;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: var(--color-black);
    pointer-events: none;
  }

  /* Order Now */
  #{{ section.id }} .product-main__add {
    align-self: flex-start;
    min-width: 192px;
    margin-top: 8px;
    padding: 22px 44px;
    border: none;
    border-radius: 53px;
    background: var(--color-red);
    color: var(--color-white);
    font-size: var(--text-1);
    font-weight: var(--font-primary-weight-medium);
    cursor: pointer;
    box-shadow: 0 22px 26px rgba(0, 0, 0, 0.12);
    transition: background 0.18s ease, opacity 0.18s ease;
  }
  #{{ section.id }} .product-main__add:hover:not(:disabled) {
    background: var(--color-black);
  }
  #{{ section.id }} .product-main__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 1023px) {
    #{{ section.id }} .product-main__card {
      gap: 40px;
    }
    #{{ section.id }} .product-breadcrumb {
      margin-bottom: 36px;
    }
  }
  @media (max-width: 767px) {
    #{{ section.id }} .product-main__card {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 48px;
    }
    #{{ section.id }} .product-main__media {
      max-width: 360px;
      margin: 0 auto;
      border-radius: 32px;
    }
    #{{ section.id }} .product-main__add {
      align-self: stretch;
      width: 100%;
      text-align: center;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "text",
      "id": "breadcrumb_title",
      "label": "Breadcrumb / banner title",
      "default": "Menu"
    },
    {
      "type": "url",
      "id": "menu_url",
      "label": "Breadcrumb \"Menu\" link"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Image panel background",
      "default": "#D90000"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
