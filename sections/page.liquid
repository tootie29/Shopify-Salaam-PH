{% comment %}
  Default page template main section: a branded title/breadcrumb banner and the
  page content rendered in a readable, on-brand container.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<section
  id="{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="page"
  class="page-main"
>
  {% comment %} -------- Title / breadcrumb bar -------- {% endcomment %}
  <div class="page-banner">
    <div class="section--container">
      <p class="page-banner__title">{{ page.title }}</p>
      <nav class="page-banner__path" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">|</span>
        <span class="page-banner__current">{{ page.title }}</span>
      </nav>
    </div>
  </div>

  {% comment %} -------- Page content -------- {% endcomment %}
  <div class="section--container">
    <article class="page-main__content rte">
      {{ page.content }}
    </article>
  </div>
</section>

{% style %}
  /* Full-bleed section; inner containers stay at page width */
  #{{ section.id }} {
    width: 100%;
  }
  #{{ section.id }} .section--container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  /* Banner */
  #{{ section.id }} .page-banner {
    background-color: var(--color-red);
    color: var(--color-white);
    padding: 22px 0;
    margin-bottom: 40px;
  }
  #{{ section.id }} .page-banner__title {
    margin: 0 0 6px;
    font-size: var(--text-3);
    font-weight: var(--font-primary-weight-bold);
    line-height: 1;
    color: var(--color-white);
  }
  #{{ section.id }} .page-banner__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text--1);
    font-weight: var(--font-primary-weight-medium);
  }
  #{{ section.id }} .page-banner__path a {
    color: var(--color-white);
    text-decoration: none;
    opacity: 0.92;
  }
  #{{ section.id }} .page-banner__path a:hover {
    text-decoration: underline;
  }
  #{{ section.id }} .page-banner__path span {
    opacity: 0.75;
  }
  #{{ section.id }} .page-banner__current {
    font-weight: var(--font-primary-weight-bold);
  }

  /* Content */
  #{{ section.id }} .page-main__content {
    max-width: 820px;
    margin: 0 auto 56px;
    font-size: var(--text-0);
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.82);
  }
  #{{ section.id }} .page-main__content > :first-child {
    margin-top: 0;
  }
  #{{ section.id }} .page-main__content > :last-child {
    margin-bottom: 0;
  }
  #{{ section.id }} .page-main__content h2,
  #{{ section.id }} .page-main__content h3,
  #{{ section.id }} .page-main__content h4 {
    color: var(--color-black);
    font-weight: var(--font-primary-weight-bold);
    line-height: 1.2;
    margin: 1.6em 0 0.5em;
  }
  #{{ section.id }} .page-main__content h2 {
    font-size: var(--text-2);
  }
  #{{ section.id }} .page-main__content h3 {
    font-size: var(--text-1);
  }
  #{{ section.id }} .page-main__content a {
    color: var(--color-red);
    text-decoration: underline;
  }
  #{{ section.id }} .page-main__content img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
  }
  #{{ section.id }} .page-main__content ul,
  #{{ section.id }} .page-main__content ol {
    padding-left: 1.4em;
  }
  #{{ section.id }} .page-main__content li {
    margin-bottom: 0.4em;
  }

  @media (max-width: 767px) {
    #{{ section.id }} .page-banner {
      margin-bottom: 28px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
